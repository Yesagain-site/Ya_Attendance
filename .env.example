# Copy to .env and adjust. docker-compose reads this file.

# --- Device ---
# Set the terminal to a STATIC IP, then put it here.
ZK_DEVICE_IP=128.0.128.174
ZK_DEVICE_PORT=4370
ZK_COMM_PASSWORD=0
ZK_DEVICE_SN=CQRT231060212

# How often the backend auto-pulls new punches (seconds). 0 disables the scheduler.
SYNC_INTERVAL_SECONDS=300

# --- Postgres ---
POSTGRES_USER=zkt
POSTGRES_PASSWORD=zkt_local_pw
POSTGRES_DB=zkt_attendance
POSTGRES_PORT=5432

# --- Ports exposed on the host ---
BACKEND_PORT=8000
FRONTEND_PORT=8090
